# Copy to .env and fill in. Real environment variables override this file.
# Never commit .env.

# Live traffic on the map. Free key: https://developer.tomtom.com/
TOMTOM_API_KEY=
# TOMTOM_DAILY_TILE_BUDGET=6000

# A real camera for a ghat instead of the video in footage/ (RTSP URL, file path or webcam number).
# CCTV_SOURCE_RAM_GHAT=rtsp://user:password@10.0.0.5:554/stream
# CCTV_SOURCE_MANGALNATH_GHAT=
# CCTV_SOURCE_TRIVENI_GHAT=
# CCTV_SOURCE_GAU_GHAT=

# Heads in view per CCTV camera that count as overcrowded (cam1 is the first ghat).
# HEADCOUNTER_DEFAULT_LIMIT=50
# HEADCOUNTER_CAMERA_LIMITS=cam1=80,cam3=40
